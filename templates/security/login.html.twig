{% extends 'base.html.twig' %}

{% block title %}Z_Survival — Connexion{% endblock %}

{% block body %}
    <section class="auth-panel">
        <p class="eyebrow">ACCÈS SURVIVANT</p>
        <h1>Connexion</h1>
        {% if error %}<p class="flash flash-warning">Adresse e-mail ou mot de passe incorrect.</p>{% endif %}
        <form action="{{ path('app_login') }}" method="post" class="auth-form">
            <label for="email">Adresse e-mail</label>
            <input id="email" name="email" type="email" value="{{ lastUsername }}" autocomplete="email" required autofocus>
            <label for="password">Mot de passe</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="button" type="submit"><span>Se connecter</span><b>→</b></button>
        </form>
        <p>Pas encore de compte ? <a href="{{ path('app_register') }}">Inscris-toi</a></p>
    </section>
{% endblock %}
