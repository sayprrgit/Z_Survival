{% extends 'base.html.twig' %}

{% block title %}Z_Survival — Partie{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <section class="arena" data-game-root>
        <header class="arena-hud"><strong>{{ character.name }}</strong><span>Éliminations <b data-kills>0</b></span><span><b data-health>{{ character.baseHealth }}</b> PV</span><span><b data-time>00:00</b></span></header>
        <div class="health-track"><span data-health-bar></span></div>
        <div class="shooter-status"><span class="shooter-label">ARME ACTIVE</span><strong data-active-weapon>Arme</strong><span class="shooter-ammo"><b data-ammo>-- / --</b><small data-reload-status>RÉSERVE --</small></span></div>
        <button class="arena-pause" type="button" data-game-pause aria-pressed="false">Pause</button>
        <button class="arena-fullscreen" type="button" data-game-fullscreen aria-pressed="false">Plein écran</button>
        <div class="arena-objective"><span>Vague <b data-wave>1</b></span><span data-objective>Tenir jusqu'à l'arrivée du Patient Zéro.</span></div>
        <div class="arena-loadout" data-weapons aria-label="Armes équipées"></div>
        <div class="arena-augments" data-augments aria-label="Augmentations actives"></div>
        <div class="arena-loot-key"><span class="loot-ammo">BLEU · munitions</span><span class="loot-weapon">OR · arme</span><span class="loot-upgrade">VIOLET · augmentation</span><span class="loot-chest">COFFRE · E pour ouvrir</span></div>
        <canvas data-game-canvas aria-label="Jeu de survie. Déplacement avec ZQSD ou les flèches."></canvas>
        <p class="arena-help">Déplacement : ZQSD / WASD / flèches · 1–6 ou clic : changer d’arme · X : arme suivante · R : recharger · E : ouvrir un coffre</p>
        <div class="upgrade-overlay" data-upgrade hidden><div class="upgrade-dialog"><p class="eyebrow">COFFRE OUVERT</p><h2>Choisis une amélioration</h2><div data-upgrade-options></div></div></div>
        <div class="upgrade-overlay" data-game-over hidden><div class="upgrade-dialog"><p class="eyebrow">PARTIE TERMINÉE</p><h2 data-end-title></h2><p data-end-stats></p><a class="button button-secondary" href="{{ path('character_index') }}">Retour au choix du survivant</a></div></div>
        <script type="application/json" data-game-config>{{ gameConfiguration|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
    </section>
{% endblock %}
