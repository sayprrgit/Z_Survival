{% extends 'base.html.twig' %}

{% block title %}Z_Survival — Accueil{% endblock %}

{% block body_class %}home-page{% endblock %}

{% block body %}
    {% set activeCode = selectedCharacterCode ?: (characters|first).code.value %}
    {% set portraits = {mason: 'mason-soldier.webp', raven: 'raven-scout.webp', boris: 'boris-mechanic.webp', eva: 'eva-medic.webp'} %}

    <section class="landing-section" aria-labelledby="landing-title">
        <div class="landing-copy">
            <p class="eyebrow"><span class="status-dot"></span> Procédure d'évacuation active</p>
            <h1 id="landing-title">Survis à<br><em>la horde.</em></h1>
            <p>Les rues sont tombées. Les communications sont coupées. Affronte {{ mobs|length }} menaces recensées, tiens quinze minutes et récupère ce qui reste de la ville.</p>
            <a class="button" href="#survivors"><span>Voir les survivants</span><b>↓</b></a>
        </div>
        <p class="scroll-cue" aria-hidden="true"><span></span> Défile pour entrer dans la zone</p>
    </section>

    <section id="survivors" class="survivor-section" data-survivor-roster aria-labelledby="survivors-title">
        <header class="survivor-section-header">
            <div>
                <p class="eyebrow">Armurerie mobile // {{ characters|length }} survivants</p>
                <h2 id="survivors-title">Sélectionne<br>ton <em>profil.</em></h2>
            </div>
            <p>Chaque survivant impose son rythme de combat. Le choix est conservé dans cette session.</p>
        </header>

        <div class="survivor-showcase">
            <div class="survivor-stage" aria-live="polite">
                {% for character in characters %}
                    <article class="survivor-panel {{ character.code.value == activeCode ? 'is-active' : '' }}" data-survivor-panel="{{ character.code.value }}" data-portrait="{{ asset('images/characters/' ~ portraits[character.code.value]) }}" aria-hidden="{{ character.code.value == activeCode ? 'false' : 'true' }}">
                        <div class="survivor-art portrait-{{ character.code.value }}" aria-hidden="true"></div>
                        <div class="survivor-details">
                            <p class="character-role">Dossier {{ character.code.value|upper }} // {{ character.id }}</p>
                            <h3>{{ character.name }}</h3>
                            <p class="survivor-description">{{ character.description }}</p>
                            <dl class="survivor-stats">
                                <div><dt>Intégrité</dt><dd>{{ character.baseHealth }} <small>PV</small></dd></div>
                                <div><dt>Arme initiale</dt><dd>{{ character.startingWeapon.name }}</dd></div>
                            </dl>
                            <p class="passive"><span>Capacité passive</span>{{ character.passiveDescription }}</p>
                            <form action="{{ path('character_select', {code: character.code.value}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('select-character') }}">
                                <label class="difficulty-picker">Difficulté
                                    <select name="difficulty">
                                        {% for difficulty in difficulties %}
                                            <option value="{{ difficulty.code.value }}" {{ difficulty.code.value == selectedDifficultyCode ? 'selected' : '' }}>{{ difficulty.name }} ×{{ difficulty.multiplier }}</option>
                                        {% endfor %}
                                    </select>
                                </label>
                                <button class="button" type="submit"><span>Déployer {{ character.name }}</span><b>→</b></button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <aside class="survivor-sidebar" aria-label="Liste des survivants">
                <p class="panel-label">Dossier survivants</p>
                {% for character in characters %}
                    <button class="survivor-tab {{ character.code.value == activeCode ? 'is-active' : '' }}" type="button" data-survivor-select="{{ character.code.value }}" aria-pressed="{{ character.code.value == activeCode ? 'true' : 'false' }}">
                        <span class="survivor-number">0{{ loop.index }}</span>
                        <span><strong>{{ character.name }}</strong><small>{{ character.startingWeapon.name }}</small></span>
                    </button>
                {% endfor %}
            </aside>
        </div>
    </section>

    <section id="threats" class="threat-section" aria-labelledby="threats-title">
        <header class="threat-section-header">
            <div>
                <p class="eyebrow">Scanner biologique // {{ mobs|length }} signatures</p>
                <h2 id="threats-title">Menaces<br><em>identifiées.</em></h2>
            </div>
            <p>Les paramètres affichés proviennent directement du catalogue de mobs en base de données.</p>
        </header>

        <div class="mob-grid">
            {% for mob in mobs %}
                <article class="mob-card mob-{{ mob.code.value }} {{ mob.isBoss ? 'is-boss' : '' }}">
                    <div class="mob-signal" aria-hidden="true"><span>{{ mob.code.value|slice(0, 1)|upper }}</span></div>
                    <div class="mob-card-header">
                        <p>{{ mob.isBoss ? 'Boss' : 'Infecté' }} // {{ mob.code.value|upper }}</p>
                        <h3>{{ mob.name }}</h3>
                    </div>
                    <p class="mob-description">{{ mob.description }}</p>
                    <dl class="mob-stats">
                        <div><dt>PV</dt><dd>{{ mob.baseHealth }}</dd></div>
                        <div><dt>Dégâts</dt><dd>{{ mob.baseDamage }}</dd></div>
                        <div><dt>Vitesse</dt><dd>{{ mob.movementSpeed }}</dd></div>
                        <div><dt>XP</dt><dd>{{ mob.experienceReward }}</dd></div>
                    </dl>
                    <p class="mob-timing">{{ mob.isBoss ? 'Apparition critique' : 'Disponible dès' }} <strong>{{ mob.availableFromSeconds }} s</strong></p>
                </article>
            {% endfor %}
        </div>
    </section>
{% endblock %}
