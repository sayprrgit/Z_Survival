{% extends 'base.html.twig' %}

{% block title %}Z_Survival — Inscription{% endblock %}

{% block body %}
    <section class="auth-panel">
        <p class="eyebrow">NOUVEAU SURVIVANT</p>
        <h1>Créer un compte</h1>
        {{ form_start(registrationForm, {attr: {class: 'auth-form'}}) }}
            {{ form_row(registrationForm.email) }}
            {{ form_row(registrationForm.plainPassword.first) }}
            {{ form_row(registrationForm.plainPassword.second) }}
            {{ form_errors(registrationForm) }}
            {{ form_widget(registrationForm.submit, {attr: {class: 'button'}}) }}
        {{ form_end(registrationForm) }}
        <p>Tu as déjà un compte ? <a href="{{ path('app_login') }}">Connecte-toi</a></p>
    </section>
{% endblock %}
